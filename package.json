{
  "name": "@webship.co/workspace-drupal",
  "version": "1.0.12",
  "description": "Drupal for Webship Workspace: one builder for Drupal core (`cmd-drupal-project.sh`, Drupal 11, 12 or a named release) and the Drush tool in every sites folder, the default accounts, the Drupal core step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-drupal.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "docs",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "drupal",
    "label": "Drupal",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-drupal-project.sh",
        "commands/cmd-tools-drupal-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-drupal.sh"
      ],
      "args": [
        "scripts/args/arg-drupal.sh",
        "scripts/args/arg-drupal-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/drupal-site-builder.md",
        "ai/agents/drupal-tester.md"
      ],
      "skills": [
        "ai/skills/drupal-scenarios"
      ],
      "commands": [
        "ai/commands/drupal-test.md"
      ],
      "prompts": [
        "ai/prompts/drupal-build-and-test.md"
      ]
    },
    "features": [
      "features/drupal.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
